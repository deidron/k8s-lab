{
  "uid": "service-red",
  "title": "Service — RED",
  "tags": ["k8s-lab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_server_request_duration_seconds_count, env)",
        "refresh": 1,
        "includeAll": true,
        "multi": false,
        "current": { "text": "dev", "value": "dev" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requests per second",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{env=~\"$env\", app=\"k8s-lab\", http_route!~\"/metrics|/healthz\"}[5m]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Share of 5xx responses",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_server_request_duration_seconds_count{env=~\"$env\", app=\"k8s-lab\", http_route!~\"/metrics|/healthz\", http_response_status_code=~\"5..\"}[5m])) or on() vector(0)) / clamp_min(sum(rate(http_server_request_duration_seconds_count{env=~\"$env\", app=\"k8s-lab\", http_route!~\"/metrics|/healthz\"}[5m])), 0.0001)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Latency p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{env=~\"$env\", app=\"k8s-lab\", http_route!~\"/metrics|/healthz\"}[5m])))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active requests",
      "description": "At least 1 during every scrape: the /metrics request counts itself.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_server_active_requests{env=~\"$env\", app=\"k8s-lab\"})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency quantiles",
      "description": "Derived from the http_server_request_duration_seconds histogram — a built-in ASP.NET Core metric, no instrumentation required.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 5 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{env=~\"$env\", app=\"k8s-lab\", http_route!~\"/metrics|/healthz\"}[5m])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{env=~\"$env\", app=\"k8s-lab\", http_route!~\"/metrics|/healthz\"}[5m])))"
        },
        {
          "refId": "C",
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{env=~\"$env\", app=\"k8s-lab\", http_route!~\"/metrics|/healthz\"}[5m])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by route",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{http_route}} {{http_response_status_code}}",
          "expr": "sum by (http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{env=~\"$env\", app=\"k8s-lab\", http_route!~\"/metrics|/healthz\"}[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Calls to /api/info by pod",
      "description": "The application's own counter, see AppMetrics.cs. The node label distinguishes instances.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{pod}}",
          "expr": "sum by (pod) (rate(api_info_requests_total{env=~\"$env\"}[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Process memory (.NET)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 5 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "heap {{pod}}",
          "expr": "sum by (pod) (dotnet_gc_last_collection_heap_size_bytes{env=~\"$env\", app=\"k8s-lab\"})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors in logs",
      "description": "Catches what HTTP metrics miss: exceptions handled before a response is formed, and background job failures.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20, "drawStyle": "bars" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{log_level}}",
          "expr": "sum by (log_level) (count_over_time({app=\"k8s-lab\", env=~\"$env\"} | json | log_level =~ \"ERROR|WARN\" [5m]))"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent /api/info traces",
      "description": "Click a row to open the trace. The way back is the TraceID field in the log feed below. Filtering by name cuts out /metrics scrapes, which would otherwise dominate. To see only slow ones, add && duration > 10ms to the query.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "query": "{resource.env=~\"$env\" && name=\"GET /api/info\"}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Log feed",
      "description": "Expand a line — the TraceID field with a link to the trace in Tempo appears at the bottom.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 30 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "{app=\"k8s-lab\", env=~\"$env\"}"
        }
      ]
    }
  ]
}
