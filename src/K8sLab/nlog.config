<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Loki" />
  </extensions>

  <variable name="jsonLayout">
    <layout xsi:type="JsonLayout" includeEventProperties="true">
      <attribute name="time_stamp" layout="${longdate}" />
      <attribute name="log_level" layout="${level:upperCase=true}" />
      <attribute name="log_message" layout="${message}" />
      <attribute name="logger_name" layout="${logger}" />
      <attribute name="trace_id" layout="${activity:property=TraceId}" />
      <attribute name="exception_details" layout="${exception:format=ToString}" />
    </layout>
  </variable>

  <targets>
    <target xsi:type="Console" name="jsonConsole" layout="${var:jsonLayout}" />
    <target xsi:type="loki" name="loki"
        endpoint="http://localhost:3100"
        batchSize="200"
        taskDelayMilliseconds="500"
        layout="${var:jsonLayout}">
      <label name="app" layout="k8s-lab" />
      <label name="env" layout="local" />
    </target>
  </targets>

  <rules>
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="jsonConsole" />
    <logger name="*" minlevel="Info" writeTo="loki">
      <filters defaultAction="Log">
        <when condition="'${environment:DOTNET_RUNNING_IN_CONTAINER}' == 'true'" action="Ignore" />
      </filters>
    </logger>
  </rules>
</nlog>
